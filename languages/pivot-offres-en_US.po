# Traduction de PIVOT Offres.
msgid ""
msgstr ""
"Project-Id-Version: PIVOT Offres 1.1.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Domain: pivot-offres\n"
"Language: en_US\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Activation impossible"
msgstr "Activation impossible"

msgid "PIVOT Offres ne peut pas fonctionner sur ce site :"
msgstr "PIVOT Offers cannot run on this site:"

msgid "PIVOT Offres est actif, mais une étape d'installation a échoué :"
msgstr "PIVOT Offers is active, but one installation step failed:"

msgid "Désactivez puis réactivez le plugin après avoir corrigé le problème."
msgstr "Deactivate then reactivate the plugin once the problem is fixed."

msgid "La configuration linguistique du site a changé."
msgstr "The site's language configuration has changed."

msgid "PIVOT Offres suit désormais %1$s, pour les langues %2$s. Les index ont été marqués comme périmés : ils se reconstruisent d'eux-mêmes, ou immédiatement depuis Cache et outils."
msgstr "PIVOT Offers now follows %1$s, for the languages %2$s. The indexes have been marked stale: they rebuild on their own, or immediately from Cache and tools."

msgid "Pensez à traduire le titre et l'URL de chaque page de listing, ainsi que le libellé de vos critères : sans traduction saisie, ils reprennent la langue par défaut."
msgstr "Remember to translate each listing page's title and URL, as well as your criteria's labels: without a translation entered, they fall back to the default language."

msgid "Voir les pages de listing"
msgstr "View the listing pages"

msgid "Enregistrer les permaliens"
msgstr "Save the permalinks"

msgid "PIVOT Offres"
msgstr "PIVOT Offers"

msgid "PIVOT"
msgstr "PIVOT"

msgid "Pages de listing"
msgstr "Listing pages"

msgid "Ajouter une page"
msgstr "Add a page"

msgid "Insérer des offres"
msgstr "Insert offers"

msgid "Shortcode"
msgstr "Shortcode"

msgid "Types d'offres"
msgstr "Offer types"

msgid "Champs affichés"
msgstr "Displayed fields"

msgid "Réglages PIVOT"
msgstr "PIVOT settings"

