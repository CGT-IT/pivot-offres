msgstr "Pictogrammen"

msgid "Les pictogrammes PIVOT (classements, équipements, balisages, épingles de carte) sont copiés sur ce site, dans les tailles et couleurs déclarées par le thème, pour que les visiteurs ne les demandent plus à PIVOT. Les manquants sont téléchargés chaque jour."
msgstr "De PIVOT-pictogrammen (classificaties, voorzieningen, bewegwijzering, kaartspelden) worden naar deze website gekopieerd, in de formaten en kleuren die het thema opgeeft, zodat bezoekers ze niet meer bij PIVOT opvragen. Ontbrekende pictogrammen worden dagelijks gedownload."

msgid "%1$d fichiers (%2$s), %3$d urn(s) sans pictogramme chez PIVOT, affichées en texte."
msgstr "%1$d bestanden (%2$s), %3$d urn(s) zonder pictogram bij PIVOT, als tekst weergegeven."

msgid "Téléchargement en cours."
msgstr "Bezig met downloaden."

msgid "Dernière vérification : %s."
msgstr "Laatste controle: %s."

msgid "Télécharger les manquants"
msgstr "Ontbrekende downloaden"

msgid "Tout retélécharger"
msgstr "Alles opnieuw downloaden"
